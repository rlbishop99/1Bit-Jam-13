    m_Response: You back out of the Cave and head back to the Glade.
    m_RequiredIntentThreshold: 100
    m_TargetLevelID: 1
  m_EyeOpenEntries: []
  m_FallbackResponse: Nothing happens.
  m_IntroResponse: "You enter the mouth of the Cave. It's dank, humid, and musty.\n\nInside
    you can see a small wooden table and chair, with a campfire slowly crackling
    nearby on a bed of rocks. \n\nThere is some food on the table.\n\nWhat do you
    do?"
