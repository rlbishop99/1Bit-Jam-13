    - m_Synonyms:
      - bridge
    m_Response: You exit the Cave and head towards the Bridge.
    m_RequiredIntentThreshold: 100
    m_TargetLevelID: 2
  - m_Keywords: []
    m_KeywordGroups:
    - m_Synonyms:
      - go
