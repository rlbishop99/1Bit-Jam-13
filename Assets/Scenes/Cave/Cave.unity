--- !u!114 &1993061892
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1993061890}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1b1c8d611d82167d5a261b2356e2656d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PromptResponses
  m_RequiredLayer: 1
  m_bIsLevelSource: 1
  m_KeywordsSO: {fileID: 11400000, guid: 8c18faa0ee9450dffa9b15813669b5b5, type: 2}
  m_BaseKeywordsSO: {fileID: 11400000, guid: a6f6517ffee44a9184d46816533fe062, type: 2}
  m_PromptResponseEntries:
  - m_Keywords:
    - look
    - around
    - area
    m_KeywordGroups:
    - m_Synonyms:
      - look
      - move
      - around
    - m_Synonyms:
      - area
      - cave
      - room
    m_Response: 'You get a better look around. The Fire is still burning brightly,
      like it has recently been tended to.


      The Chair is nestled close to
      the Fire, someone was likely sitting here recently, warming their hands.


      You
      get a faint whiff of some Food -- maybe various Meats? It smells bad though,
      like it is rotten.


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_bStartsDatingSim: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_GatingConditions: []
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
    m_MarkerToActivate: {fileID: 0}
    m_RequiredItem: {fileID: 0}
    m_ItemToRemove: {fileID: 0}
  - m_Keywords:
    - look
    - chair
    m_KeywordGroups:
    - m_Synonyms:
      - look
      - move
      - go
      - inspect
      - examine
    - m_Synonyms:
      - chair
      - stool
    m_Response: 'You look closer at the wooden chair. It''s rather plain, not carpented
      by a skilled worker. Perhaps this was crafted as a hobby?


      You can see
      there are knots in the wood where the arms are, the legs aren''t quite even
      so the chair wobbles, and it is cracked down the back.


      Poor fella,
      this chair CAN''T be comfortable.


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_bStartsDatingSim: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_GatingConditions: []
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
    m_MarkerToActivate: {fileID: 0}
    m_RequiredItem: {fileID: 0}
    m_ItemToRemove: {fileID: 0}
  - m_Keywords:
    - chair
    - sit
    m_KeywordGroups:
    - m_Synonyms:
      - sit
    - m_Synonyms:
      - chair
    m_Response: 'You sit down on the chair.


      This chair sucks. You feel worse
      for having sat down in it.


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_bStartsDatingSim: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_GatingConditions: []
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
    m_MarkerToActivate: {fileID: 0}
    m_RequiredItem: {fileID: 0}
    m_ItemToRemove: {fileID: 0}
  - m_Keywords:
    - food
    - eat
    m_KeywordGroups:
    - m_Synonyms:
      - pick
      - up
      - eat
      - look
      - inspect
    - m_Synonyms:
      - food
      - meat
    m_Response: 'You pick up some of the food and attempt to eat it.


      Wouldn''t
      you know it? Your helmet is getting in the way -- you can''t put the food in
      your mouth.


      Probably for the best though, this meat is rancid. You
      decide to put it in your pocket for later.


      ROTTEN MEAT was added to
      your ITEMS.


      What do you do?'
    m_RequiredIntentThreshold: 75
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_bStartsDatingSim: 0
    m_GatingObject: {fileID: 398167487}
    m_PresenceRequirement: 0
    m_GatingConditions:
    - m_GatingObject: {fileID: 398167487}
      m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 827586c2d4ac589479dad547e2a51f0b, type: 3}
    m_RewardItem: {fileID: 11400000, guid: 85067f37249db60c692d851a3e3095a9, type: 2}
    m_MarkerToActivate: {fileID: 0}
    m_RequiredItem: {fileID: 0}
    m_ItemToRemove: {fileID: 0}
  - m_Keywords:
    - touch
    - fire
    - hands
    - hand
    m_KeywordGroups:
    - m_Synonyms:
      - inspect
      - examine
      - look
    - m_Synonyms:
      - fire
      - flames
      - campfire
    m_Response: "You nuzzle up close to the fire. It radiates gentle comforting warmth
      and you're able to warm your hands.\n\nThe fire is burning healthily and it
      looks like some wood was recently added to it. \n"
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_bStartsDatingSim: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_GatingConditions: []
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
    m_MarkerToActivate: {fileID: 0}
    m_RequiredItem: {fileID: 0}
    m_ItemToRemove: {fileID: 0}
  - m_Keywords:
    - touch
    - fire
    - hands
    - hand
    m_KeywordGroups:
    - m_Synonyms:
      - touch
      - hand
      - hands
    - m_Synonyms:
      - fire
      - flames
      - campfire
    m_Response: 'You stick your hands in the fire. You''re wearing armor, so your
      metal gauntlets quickly begin to heat up and singe your skin.


      It hurts
      terribly, so you pull your hands out and sadly ponder your choice.


      .........


      .........why
      would you do that?


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_bStartsDatingSim: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_GatingConditions: []
    m_TriggerSFX: {fileID: 8300000, guid: c66e3741f9a2846de86a4facf9dea026, type: 3}
    m_RewardItem: {fileID: 0}
    m_MarkerToActivate: {fileID: 0}
    m_RequiredItem: {fileID: 0}
    m_ItemToRemove: {fileID: 0}
  - m_Keywords:
    - touch
    - fire
    - hands
    - hand
    m_KeywordGroups:
    - m_Synonyms:
      - grab
      - look
      - pick
      - up
      - inspect
      - examine
    - m_Synonyms:
      - stone
      - rock
      - orb
      - circle
    m_Response: 'You notice a tiny little Rock tucked behind some crates that you
      could easily have missed. You pick it up.


      Upon closer inspection, you
      can see that it has some text etched into it, but the text is fragmented and
      impossible to decipher.


      Perhaps it is a small piece of a larger stone?


      ETCHED
      STONE was added to your ITEMS.


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_bStartsDatingSim: 0
    m_GatingObject: {fileID: 398167488}
    m_PresenceRequirement: 0
    m_GatingConditions:
    - m_GatingObject: {fileID: 398167488}
      m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 827586c2d4ac589479dad547e2a51f0b, type: 3}
    m_RewardItem: {fileID: 11400000, guid: 36386064f1873c1cea24663897dd884f, type: 2}
    m_MarkerToActivate: {fileID: 0}
    m_RequiredItem: {fileID: 0}
    m_ItemToRemove: {fileID: 0}
  m_TransitionEntries:
  - m_Keywords:
    - go
    - travel
    - transition
    - move
    - bridge
    m_KeywordGroups:
    - m_Synonyms:
      - go
      - walk
      - move
      - travel
      - transition
    - m_Synonyms:
      - bridge
    m_Response: You decide to exit the Cave and head to the Bridge.
    m_RequiredIntentThreshold: 60
    m_TargetLevelID: 2
  - m_Keywords:
    - move
    - transition
    - travel
    - go
    - glade
    m_KeywordGroups:
    - m_Synonyms:
      - move
      - walk
      - go
      - travel
      - transition
    - m_Synonyms:
      - glade
    m_Response: You decide to exit the Cave and go back to the Glade.
    m_RequiredIntentThreshold: 60
    m_TargetLevelID: 1
  m_EyeOpenEntries:
  - m_Keywords: []
    m_KeywordGroups:
    - m_Synonyms:
      - open
    - m_Synonyms:
      - eye
      - eyes
    m_Response: 
    m_RequiredIntentThreshold: 100
  m_FallbackResponse: Nothing happens.
  m_IntroResponse: "You enter the mouth of the Cave. It's dank, humid, and musty.\n\nInside
    you can see a small wooden table and chair, with a campfire slowly crackling
    nearby on a bed of rocks. \n\nThere is some food on the table.\n\nWhat do you
    do?"
  m_Variations:
  - m_VariationImage: {fileID: 21300000, guid: add47d6a52fceae67bf6aa77e6fd33ea, type: 3}
    m_VariationObjects:
