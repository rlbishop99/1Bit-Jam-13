  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1127491736}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1b1c8d611d82167d5a261b2356e2656d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PromptResponses
  m_RequiredLayer: 1
  m_bIsLevelSource: 1
  m_KeywordsSO: {fileID: 11400000, guid: 8f865d107aeaa46ed9ee01324dd7dc95, type: 2}
  m_BaseKeywordsSO: {fileID: 11400000, guid: 94775bd3bea940228d8b295e9e16117f, type: 2}
  m_PromptResponseEntries:
  - m_Keywords:
    - look
    - tree
    - trees
    - inspect
    m_Response: 'You thorougly inspect the Trees. These Trees are old and strong
      of bark.


      The layers of trees feel endless, yet there must be some way
      through...right? Not that you can see from here though.


      What do you
      do?'
    m_RequiredIntentThreshold: 50
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 34
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - look
    - flower
    - flowers
    - inspect
    m_Response: 'You thorougly inspect the Flowers. They''re extraordinarily pretty,
      but don''t seem to be anything special.


      What do you do?'
    m_RequiredIntentThreshold: 30
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - look
    - stump
    - stumps
    - inspect
    m_Response: 'You thorougly inspect the Stumps. In the right Carpenter''s hands,
      these would make for some fine chairs. However, to You they''re just normal
      Stumps.


      What do you do?'
    m_RequiredIntentThreshold: 30
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - fragment
    - grab
    - take
    m_Response: 'You tenderly take the Fragment from the Fairy.


      It is shaped
      like a perfect Cube -- even squares on all six sides. You''ve never seen a
      cube as flawless as this one. Touching it feels like pure marble.


      [CUBE
      FRAGMENT] was added to your ITEMS.'
    m_RequiredIntentThreshold: 60
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 289454281}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 827586c2d4ac589479dad547e2a51f0b, type: 3}
    m_RewardItem: {fileID: 11400000, guid: 076789cc441446b1fa6a9234960cad47, type: 2}
  m_TransitionEntries:
  - m_Keywords:
    - move
    - glade
    m_Response: You decide to venture deeper into the forest towards the Glade.
    m_RequiredIntentThreshold: 100
    m_TargetLevelID: 1
  m_EyeOpenEntries:
  - m_Keywords:
    - eyes
    - open
    m_Response: 
    m_RequiredIntentThreshold: 100
  m_FallbackResponse: Nothing happens.
  m_IntroResponse: 'You find yourself in a densly wooded Forest. You know the Wizard
    lies ahead in his Tower, but he likely won''t make it easy for you to get there.


    There
    are dozens of thick trees, flowers, and stumps littering the area.


    What
    do you do?'
  m_Variations:
  - m_VariationImage: {fileID: 21300000, guid: 71c5b42f52b348babac306341f0c92e6, type: 3}
    m_VariationObjects: []
  - m_VariationImage: {fileID: 21300000, guid: 71c5b42f52b348babac306341f0c92e6, type: 3}
    m_VariationObjects:
    - {fileID: 91040188}
  - m_VariationImage: {fileID: 21300000, guid: 71c5b42f52b348babac306341f0c92e6, type: 3}
    m_VariationObjects:
    - {fileID: 91040188}
    - {fileID: 289454281}
