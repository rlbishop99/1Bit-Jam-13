  m_Script: {fileID: 11500000, guid: 1b1c8d611d82167d5a261b2356e2656d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PromptResponses
  m_KeywordsSO: {fileID: 11400000, guid: 8f865d107aeaa46ed9ee01324dd7dc95, type: 2}
  m_PromptResponseEntries:
  - m_Keywords:
    - look
    - tree
    - trees
    - inspect
    m_Response: 'You thorougly inspect the Trees. They seem utterly unremarkable.


      What
      do you do?'
    m_RequiredIntentThreshold: 30
  - m_Keywords:
    - look
    - flower
    - flowers
    - inspect
    m_Response: 'You thorougly inspect the Flowers. They''re extraordinarily pretty,
      but don''t seem to be anything special.


      What do you do?'
    m_RequiredIntentThreshold: 30
  - m_Keywords:
    - look
    - stump
    - stumps
    - inspect
    m_Response: 'You thorougly inspect the Stumps. In the right Carpenter''s hands,
      these would make for some fine chairs. However, to You they''re just normal
      Stumps.


      What do you do?'
    m_RequiredIntentThreshold: 30
  m_FallbackResponse: Nothing happens.
  m_IntroResponse: 'You find yourself in a densly wooded Forest. You know the Wizard
    lies ahead in his Tower, but he likely won''t make it easy for you to get there.


    There
    are dozens of thick trees, flowers, and stumps littering the area.


    What
    do you do?'
