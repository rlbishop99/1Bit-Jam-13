--- !u!114 &1127491738
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1127491736}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1b1c8d611d82167d5a261b2356e2656d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PromptResponses
  m_RequiredLayer: 1
  m_bIsLevelSource: 1
  m_KeywordsSO: {fileID: 11400000, guid: 7e5307754e938e51fbee82411b87c6b5, type: 2}
  m_BaseKeywordsSO: {fileID: 11400000, guid: d8d488e67edf48099795e3d5f9fb4707, type: 2}
  m_PromptResponseEntries:
  - m_Keywords:
    - look
    - around
    - examine
    - area
    m_KeywordGroups:
    - m_Synonyms:
      - look
      - move
      - examine
    - m_Synonyms:
      - glade
      - area
      - around
    m_Response: 'You walk a lap around the Glade.


      The Pond is filled with
      crystal clear water. You grab one of the cattails and eat it like a hot dog....


      Your
      mouth is instantly filled with hundreds of fluffy seeds. It certainly does
      not taste like a hot dog.


      You leave the cattails alone, all the hungrier
      for it.


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 5d8519ee34095c1918055f9aa5c05c64, type: 3}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - look
    - water
    - pond
    m_KeywordGroups:
    - m_Synonyms:
      - look
      - go
      - examine
      - inspect
      - move
    - m_Synonyms:
      - pond
    m_Response: "You take a closer look at the small Pond. \n\nIt looks to be about
      4 feet deep with nothing at the bottom; you're only met with your reflection.\n\nAs
      you see your helmet reflected in the water staring back at you, you are reminded
      of who you are and why you're here.\n\nWhat do you do?"
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - unicorn
    - date
    m_KeywordGroups:
    - m_Synonyms:
      - drink
      - sip
    - m_Synonyms:
      - pond
      - water
    m_Response: 'You scoop up a handful of water in your greaves and take a drink.


      It
      is ice cold and crisp; you feel the cold water travel down your throat and
      through your body. That''s always a fun feeling.


      Feeling refreshed
      and re-energized, you stand up and prepare to keep charging forward.


      What
      do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 0}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - stump
    m_KeywordGroups:
    - m_Synonyms:
      - look
      - examine
      - inspect
      - move
    - m_Synonyms:
      - stump
    m_Response: 'You sit down on the Stump and take a quick breather.


      The
      Glade is certainly much nicer and more relaxing than the Forest, or probably
      anywhere else for that matter.


      .....better get up, before you fall
      asleep.


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 1297066990}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - unicorn
    - date
    m_KeywordGroups:
    - m_Synonyms:
      - up
      - stump
    - m_Synonyms:
      - stand
    m_Response: 'You stand up off of the Stump and stretch your weary bones.


      You
      hardly ever stretch, but every time you do it feels amazing. You think that
      you REALLY need to stretch more.


      With a few streches you''re feeling
      nimble and alert again. The Illusionist is screwed, once you finally reach
      him.


      What do you do?'
    m_RequiredIntentThreshold: 50
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 1297066990}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 0}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - fairy
    - talk
    m_KeywordGroups:
    - m_Synonyms:
      - move
      - examine
      - inspect
      - go
      - talk
    - m_Synonyms:
      - fairy
    m_Response: 'You hear a small voice in your head....


      "Well well well,
      another Hero here to kill the Illusionist I take it?


      Did one of my
      sisters help you through the Forest? Probably, I can''t imagine you made it
      here on your own.


      Hey, fun fact...there''s a Unicorn that comes to
      this Glade occasionally? Have you seen her?"


      What do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 1054753401}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 01d79b620857f88ee934961ab8defc64, type: 3}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - unicorn
    - date
    m_KeywordGroups:
    - m_Synonyms:
      - more
      - continue
      - confirm
    - m_Synonyms:
      - talk
      - unicorn
    m_Response: 'The Fairy responds with delight.


      "That''s amazing! The Unicorn
      certainly doesn''t appear before just ANYONE. You must have caught her attention
      somehow.


      I know that she''s lonely, recently single. Perhaps you could
      cheer her up a little bit?"


      ...you think far too hard about what exactly
      the Fairy means by that.


      What do you do?'
    m_RequiredIntentThreshold: 50
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 1054753401}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 01d79b620857f88ee934961ab8defc64, type: 3}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - talk
    - unicorn
    m_KeywordGroups:
    - m_Synonyms:
      - talk
      - move
      - go
    - m_Synonyms:
      - unicorn
    m_Response: 'You approach the majestic Unicorn.


      "Whoa, hello there handsome!
      It''s been a long time since a Hero has come through my Glade.


      You''re
      tall, strapping build...an epitome of a Hero. My name is Light, by the way.
      It''s very nice to meet you!"


      The Unicorn glances shyly in your direction.


      What
      do you do?'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 904842806}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 1996ad0d223b428979e2cbfdb2e33b65, type: 3}
    m_RewardItem: {fileID: 0}
  - m_Keywords:
    - unicorn
    - date
    m_KeywordGroups:
    - m_Synonyms:
      - date
      - romance
      - kiss
      - pet
    - m_Synonyms:
      - unicorn
      - light
    m_Response: 'You attempt to flirt with Light, the Unicorn.


      "W- ...what?
      Are you really asking ME out on a DATE?


      I would be DELIGHTED! I have
      no doubts in my mind that you''ll treat me well, like any respectable Hero
      should."'
    m_RequiredIntentThreshold: 100
    m_bAdvancesLayer: 0
    m_LayerToAdvanceTo: 0
    m_GatingObject: {fileID: 904842806}
    m_PresenceRequirement: 0
    m_TriggerSFX: {fileID: 8300000, guid: 1996ad0d223b428979e2cbfdb2e33b65, type: 3}
    m_RewardItem: {fileID: 0}
  m_TransitionEntries:
  - m_Keywords:
    - move
    - forest
    m_KeywordGroups:
    - m_Synonyms:
      - move
      - travel
      - transition
      - go
    - m_Synonyms:
      - forest
    m_Response: You decide to pivot back into the Forest.
    m_RequiredIntentThreshold: 100
    m_TargetLevelID: 0
  - m_Keywords:
    - move
    - bridge
    m_KeywordGroups:
    - m_Synonyms:
      - move
      - travel
      - transition
      - go
    - m_Synonyms:
      - bridge
    m_Response: You decide to exit the Glade and head towards the Bridge.
    m_RequiredIntentThreshold: 100
    m_TargetLevelID: 2
  - m_Keywords:
    - move
    - cave
    m_KeywordGroups:
    - m_Synonyms:
      - move
      - travel
      - transition
      - go
    - m_Synonyms:
      - cave
    m_Response: You decide to exit the Glade and brave the Cave.
    m_RequiredIntentThreshold: 100
    m_TargetLevelID: 3
  m_EyeOpenEntries:
  - m_Keywords:
    - open
    - eyes
    m_KeywordGroups:
    - m_Synonyms:
      - open
    - m_Synonyms:
      - eyes
      - eye
    m_Response: 
    m_RequiredIntentThreshold: 100
  m_FallbackResponse: Nothing happens.
  m_IntroResponse: 'After traveling through a maze of trees in the Forest, you finally
    get a moment of reprieve -- a clearing at the end of the Forest...it''s a beautiful
    Glade.


    You see a perfectly circular clearing, with a small pond right in
    the center. Inside of the Pond you can see a brush of cattails growing out of
    it.


    What do you do?'
  m_Variations:
  - m_VariationImage: {fileID: 21300000, guid: 1658f50595806a06b9acb7b2a40c1e34, type: 3}
    m_VariationObjects:
    - {fileID: 242867549}
  - m_VariationImage: {fileID: 21300000, guid: 1658f50595806a06b9acb7b2a40c1e34, type: 3}
    m_VariationObjects:
    - {fileID: 242867549}
    - {fileID: 1054753401}
  - m_VariationImage: {fileID: 21300000, guid: 1658f50595806a06b9acb7b2a40c1e34, type: 3}
    m_VariationObjects:
    - {fileID: 242867549}
    - {fileID: 1297066990}
  - m_VariationImage: {fileID: 21300000, guid: 1658f50595806a06b9acb7b2a40c1e34, type: 3}
    m_VariationObjects:
    - {fileID: 242867549}
    - {fileID: 1297066990}
    - {fileID: 904842806}
  - m_VariationImage: {fileID: 21300000, guid: 1658f50595806a06b9acb7b2a40c1e34, type: 3}
    m_VariationObjects:
    - {fileID: 242867549}
    - {fileID: 1054753401}
